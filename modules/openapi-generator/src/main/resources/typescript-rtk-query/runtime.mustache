export const BASE_PATH = "{{{basePath}}}".replace(/\/+$/, "");

export class RequiredError extends Error {
    name: "RequiredError" = "RequiredError";
    constructor(public field: string, msg?: string) {
        super(msg);
    }
}

export const COLLECTION_FORMATS = {
    csv:   ",",
    ssv:   " ",
    tsv:   "\t",
    pipes: "|",
};

export type HttpHeaders = { [key: string]: string };

export type ModelPropertyNaming = 'camelCase' | 'snake_case' | 'PascalCase' | 'original';

/**
 * Default header preparation hook.
 * Override this in your own baseApi.ts if you need custom auth headers.
 */
export function prepareHeaders(headers: Headers): Headers {
    return headers;
}

export function exists(json: any, key: string): boolean {
    const value = json[key];
    return value !== null && value !== undefined;
}

export function mapValues(data: any, fn: (item: any) => any): any {
    return Object.keys(data).reduce(
        (acc, key) => ({ ...acc, [key]: fn(data[key]) }),
        {}
    );
}

export function canConsumeForm(consumes: { contentType: string }[]): boolean {
    for (const consume of consumes) {
        if ('multipart/form-data' === consume.contentType) {
            return true;
        }
    }
    return false;
}

